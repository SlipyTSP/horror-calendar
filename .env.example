# API key de TMDB (v3) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Idioma para los resultados (es-ES, en-US, etc.)
TMDB_LANGUAGE=es-ES

# Región para fechas de estreno (ES, US, MX, AR, etc.)
TMDB_REGION=ES

# Días hacia delante en los que buscar estrenos (entero 1-366, por defecto 90)
# WINDOW_DAYS=90

# Páginas de discover/movie leídas por consulta (entero 1-20, por defecto 5)
# MAX_PAGES=5

# Regla de duración: solo entran películas de al menos estos minutos, o sin duración en
# TMDB pero con imdb_id (entero 0-300, por defecto 40; 0 desactiva la regla entera)
# MIN_RUNTIME=40

# Altas manuales curadas desde la prensa española (ruta relativa a la raíz del repo)
# MANUAL_RELEASES_FILE=data/manual-releases.json

# Foto anterior del catálogo de plataformas (solo https). Vacía → modo semilla: el build
# escribe la foto nueva pero no detecta llegadas. CI usa la copia publicada en Pages:
# SNAPSHOT_URL=https://slipytsp.github.io/horror-calendar/providers-snapshot.json

# Días que una llegada a plataforma sigue en los calendarios (entero 1-90, por defecto 30)
# ARRIVAL_DAYS=30

# Antigüedad máxima del catálogo vigilado para llegadas, en años (entero 1-20, por defecto 3)
# ARRIVAL_MAX_AGE_YEARS=3

# Páginas leídas por plataforma en la consulta de llegadas (entero 1-100, por defecto 50)
# ARRIVAL_MAX_PAGES=50

# Tope de llegadas nuevas por plataforma y semana; por encima no se publica ninguna
# (entero 1-500, por defecto 25)
# ARRIVAL_MAX_PER_PLATFORM=25
